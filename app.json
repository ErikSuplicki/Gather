{
  "expo": {
    "name": "Gather",
    "slug": "Gather",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/Logo_With_Border.png",
    "scheme": "gather",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.eriksuplicki.Gather",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/Logo_With_Border.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/Logo_With_Border.png",
          "resizeMode": "contain",
          "backgroundColor": "#0F1011"
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "739e258a-b4a9-4c3f-bb50-5c2e3cd60019"
      }
    }
  }
}
